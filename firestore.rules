rules_version = '2';
// Job Tracker keeps per-user data under users/{uid}. Only the app's server
// reads and writes it, through the Firebase Admin SDK (which these rules
// don't apply to). Browsers and any other client get no direct access.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
