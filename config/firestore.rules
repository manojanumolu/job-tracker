rules_version = '2';
// Job Tracker keeps per-user data under users/{uid} — including the
// admins' Application Tracker (users/{uid}/applications). Only the app's
// server reads and writes it, through the Firebase Admin SDK (which these
// rules don't apply to), after checking the signed-in admin and their UID.
// Browsers and any other client get no direct access to any of it.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
